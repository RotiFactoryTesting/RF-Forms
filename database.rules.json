      "$form": {
        ".read": "auth != null && ((root.child('access').child(auth.uid).exists() && root.child('access').child(auth.uid).child('disabled').val() !== true && (root.child('access').child(auth.uid).child('isAdmin').val() === true || root.child('access').child(auth.uid).child('canReport').val() === true || ((query.orderByChild === 'uid' && query.equalTo === auth.uid) && (root.child('access').child(auth.uid).child('forms').val() === 'ALL' || root.child('access').child(auth.uid).child('formAccess').child($form).val() === true)))) || (auth.token.firebase.sign_in_provider === 'anonymous' && query.orderByChild === 'uid' && query.equalTo === auth.uid))",
        ".indexOn": ["uid"],
        "$entry": {
          ".write": "auth != null && ((root.child('access').child(auth.uid).exists() && root.child('access').child(auth.uid).child('disabled').val() !== true && (root.child('access').child(auth.uid).child('isAdmin').val() === true || ((root.child('access').child(auth.uid).child('forms').val() === 'ALL' || root.child('access').child(auth.uid).child('formAccess').child($form).val() === true) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))))) || (auth.token.firebase.sign_in_provider === 'anonymous' && !data.exists() && newData.child('uid').val() === auth.uid))"
        }
      }
    },
    "attendance_staff": {
      ".read": "auth != null && root.child('access').child(auth.uid).child('disabled').val() !== true && (root.child('access').child(auth.uid).child('isAdmin').val() === true || root.child('access').child(auth.uid).child('canAttendance').val() === true)",
      ".write": "auth != null && root.child('access').child(auth.uid).child('disabled').val() !== true && root.child('access').child(auth.uid).child('isAdmin').val() === true"
    },
    "attendance_machines": {
